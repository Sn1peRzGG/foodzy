datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      Int      @unique
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  phoneNumber String   @unique
  city        String
  address     String
  role        Role     @default(USER)
  avatarUrl   String
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  Int      @unique
  name        String
  imageUrl    String
  count       Int
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  productId   Int      @unique
  name        String
  description String
  imageUrl    String
  category    String
  price       Float
  oldPrice    Float?
  rating      Float
}
enum Role {
  USER
  ADMIN
}